<UserControl x:Class="BBC.BSC.Tool.GUI.DiraLauncher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BBC.BSC.Tool.GUI"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#FFE5E5E5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{DynamicResource MaterialDesignTitleTextBlock}" Margin="10">
            DIRA tools found on this machine:
        </TextBlock>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DiraToolsPanel" Margin="30,0"/>
        </ScrollViewer>

        <TextBlock x:Name="TextBlockEmpty"
                   Grid.Row="1"
                   Text="No DIRA installation found on this machine."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="Gray" FontStyle="Italic"/>
    </Grid>
</UserControl>
