<UserControl x:Class="BBC.BSC.Tool.GUI.DiraLauncher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BBC.BSC.Tool.GUI"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#FFE5E5E5" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{DynamicResource MaterialDesignTitleTextBlock}" Margin="0,0,0,10">
                DIRA tools found on this machine:
            </TextBlock>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DiraToolsPanel" Margin="10,0,0,0"/>
                </ScrollViewer>

                <TextBlock x:Name="TextBlockToolsEmpty"
                           Text="No DIRA installation found on this machine."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" FontStyle="Italic"/>
            </Grid>
        </Grid>

        <Separator Grid.Column="1" Margin="0,5"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{DynamicResource MaterialDesignTitleTextBlock}" Margin="0,0,0,10">
                Sites:
            </TextBlock>

            <Grid Grid.Row="1">
                <ListBox x:Name="ListBoxSites" SelectionChanged="ListBoxSites_SelectionChanged"/>
                <TextBlock x:Name="TextBlockSitesEmpty"
                           Text="No sites found in DIRA workgroup registry keys."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" FontStyle="Italic"/>
            </Grid>

            <Button Grid.Row="2"
                    x:Name="ButtonLaunchHighlander"
                    Content="Launch Highlander"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Padding="15,5"
                    Click="ButtonLaunchHighlander_Click"
                    IsEnabled="False"/>
        </Grid>
    </Grid>
</UserControl>
